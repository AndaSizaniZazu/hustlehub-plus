# Used by docker-compose.yml. Copy to .env (git-ignored) and fill in.
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<a long random string>
JWT_EXPIRES_IN=1h
AUTH_RATE_LIMIT=5
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15
# Leave unset to use the bundled MongoDB container, or set an Atlas URI
# MONGO_URI=mongodb+srv://...
