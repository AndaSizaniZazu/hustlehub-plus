{
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.5",
    "morgan": "^1.12.0",
    "sanitize-html": "^2.18.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "newman": "^6.2.3",
    "newman-reporter-htmlextra": "^1.23.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint .",
    "lint:report": "eslint . -f json -o ../evidence/eslint-backend.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:api": "newman run ../postman/HustleHub.postman_collection.json --insecure -r cli,htmlextra --reporter-htmlextra-export ../postman/reports/newman-report.html"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "coverageReporters": [
      "text-summary",
      "text",
      "lcov"
    ]
  }
}
